# Copy to .env.analytics and replace the hash with your own BCrypt hash.
# Keep single quotes around the hash so Compose does not expand its dollar signs.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
ANALYTICS_DB_PASSWORD='REPLACE_WITH_ANALYTICS_DB_PASSWORD'
BROKERAGE_DB_PASSWORD='REPLACE_WITH_TRADING_DB_PASSWORD'
JWT_SECRET='REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES'
# Run the relay only on the designated stack connected to the shared OLAP database.
BROKERAGE_ANALYTICS_ENABLED=true
# Shared development OLTP database used by the backend.
BROKERAGE_DB_URL=jdbc:postgresql://10.18.67.77:8090/jarbis_db
# Required when market-data polling is enabled.
BROKERAGE_MARKET_DATA_API_KEY='fnx_dev_ynMH4HwnxqC9EljRB9BjjtbRyPLUgPOP'
# Set true behind HTTPS. Keep false only for localhost HTTP development.
ANALYTICS_SECURE_COOKIE=false

# Optional frontend dev origin. Leave empty for a same-origin reverse proxy.
ANALYTICS_ALLOWED_ORIGINS=http://localhost:4200

# Shared development OLAP database used by the analytics service.
ANALYTICS_DB_URL=postgresql://10.18.67.77:8091/jarbis_olap
# Shared development OLAP database used by the backend relay.
BROKERAGE_ANALYTICS_DB_URL=jdbc:postgresql://10.18.67.77:8091/jarbis_olap

# David: a separate operations identity with its own BCrypt hash.
ANALYTICS_OPERATIONS_USER=david
ANALYTICS_OPERATIONS_PASSWORD_HASH='REPLACE_WITH_OPERATIONS_BCRYPT_HASH'
