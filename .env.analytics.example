# Copy to .env.analytics and replace the hash with your own BCrypt hash.
# Keep single quotes around the hash so Compose does not expand its dollar signs.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD_HASH=
ANALYTICS_DB_PASSWORD=replace_with_local_olap_password
BROKERAGE_DB_PASSWORD=replace_with_local_oltp_password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
# Each developer's backend delivers its own local OLTP outbox to its local OLAP.
BROKERAGE_ANALYTICS_ENABLED=true
# Local container URL. Compose pins this target so old remote values cannot redirect it.
BROKERAGE_DB_URL=jdbc:postgresql://postgres:5432/jarbis_db
# Required when market-data polling is enabled.
BROKERAGE_MARKET_DATA_API_KEY=
# Set true behind HTTPS. Keep false only for localhost HTTP development.
ANALYTICS_SECURE_COOKIE=false

# Optional frontend dev origin. Leave empty for a same-origin reverse proxy.
ANALYTICS_ALLOWED_ORIGINS=http://localhost:4200

# Local OLAP URL for the analytics service.
ANALYTICS_DB_URL=postgresql://postgres-olap:5432/jarbis_olap
# Local OLAP JDBC URL for the backend relay.
BROKERAGE_ANALYTICS_DB_URL=jdbc:postgresql://postgres-olap:5432/jarbis_olap

# Optional operations login: set BOTH fields, or leave BOTH blank.
ANALYTICS_OPERATIONS_USER=
ANALYTICS_OPERATIONS_PASSWORD_HASH=
# Optional: keep this if you already use the fresh baseline project; do not rename an existing project unintentionally.
# COMPOSE_PROJECT_NAME=jarbis-baseline
